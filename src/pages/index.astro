---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';

// Newest work first. `date` is already a Date thanks to z.coerce.date().
const artworks = (await getCollection('artworks')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Renee Bibby" description="Selected artwork by Renee Bibby">
  <ul class="grid">
    {artworks.map(({ id, data }) => (
      <li>
        <a href={`/work/${id}/`} class="thumb">
          <Image src={data.image} alt={data.description} width={800} />
          <span class="caption">
            <span>{data.title}</span>
            <span class="muted">{data.date.getFullYear()}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* TODO(human): decide how the gallery lays out.
       Set grid-template-columns and gap here, and the thumbnail
       image's aspect-ratio / object-fit in the .thumb img rule below. */
  }

  .thumb {
    display: block;
  }

  .thumb img {
    width: 100%;
    /* aspect-ratio and object-fit: set alongside the .grid rule above. */
  }

  .thumb:hover {
    text-decoration: none;
  }

  .thumb:hover img {
    opacity: 0.9;
  }

  .caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
</style>
